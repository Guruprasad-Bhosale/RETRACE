# ==============================================================================
# RETRACE - Environment Configuration Template
# Copy this file to .env for local development with real credentials
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SERVICE_NAME=retrace-api

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200"]

# Database (PostgreSQL + pgvector ready)
# For local dev / testing: postgresql+asyncpg://postgres:postgres@localhost:5432/retrace_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/retrace_dev
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/retrace_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30

# Redis (Redis Streams for Worker Jobs)
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=retrace:analysis:jobs
REDIS_CONSUMER_GROUP=retrace-worker-group

# Artifact Storage (local or s3)
STORAGE_BACKEND=local
# Path for local disk backend
STORAGE_LOCAL_DIR=./storage_data/artifacts

# S3 / MinIO Settings (used when STORAGE_BACKEND=s3)
STORAGE_S3_ENDPOINT_URL=http://localhost:9000
STORAGE_S3_BUCKET=retrace-artifacts
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=false

# AI Provider Configuration (Future Phases)
AI_PROVIDER=openai
OPENAI_API_KEY=sk-placeholder-do-not-commit-real-keys
OPENAI_MODEL=gpt-4o
