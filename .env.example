# ==============================================================================
# RETRACE - Environment Configuration Template
# Copy this file to .env for local development with real credentials
# ==============================================================================

# Application Environment (development | test | staging | production)
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_FORMAT=json
SERVICE_NAME=retrace-api
SECRET_KEY=retrace-dev-secret-key-change-in-production

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:4200", "http://127.0.0.1:4200"]
ALLOWED_HOSTS=["*"]
ENABLE_SECURITY_HEADERS=true

# Database (PostgreSQL)
# For local dev: postgresql+asyncpg://postgres:postgrespassword@localhost:5432/retrace_dev
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/retrace_dev
DATABASE_SYNC_URL=postgresql://postgres:postgrespassword@localhost:5432/retrace_dev
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_AUTO_MIGRATE=false

# Redis (Redis Streams for Worker Jobs)
REDIS_URL=redis://localhost:6379/0
REDIS_STREAM_KEY=retrace:analysis:jobs
REDIS_CONSUMER_GROUP=retrace-worker-group
REDIS_MAX_CONNECTIONS=20
REDIS_JOB_TIMEOUT_S=900
REDIS_MAX_DELIVERY_ATTEMPTS=3

# Artifact Storage (local | s3)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage_data/artifacts

# S3 / MinIO Settings (used when STORAGE_BACKEND=s3)
STORAGE_S3_ENDPOINT_URL=http://localhost:9000
STORAGE_S3_BUCKET=retrace-artifacts
STORAGE_S3_ACCESS_KEY=minioadmin
STORAGE_S3_SECRET_KEY=minioadmin
STORAGE_S3_REGION=us-east-1
STORAGE_S3_USE_SSL=false
STORAGE_S3_PREFIX=artifacts

# Worker Resource Boundaries & Sandbox Security
WORKER_CONCURRENCY=4
WORKER_MAX_MEMORY_MB=2048
WORKER_MAX_EXECUTION_TIME_S=600
WORKER_MAX_BROWSER_PAGES=50
WORKER_MAX_EXPLORATION_STATES=100
WORKER_MAX_ARTIFACT_SIZE_MB=100
WORKER_BROWSER_SANDBOX=true
WORKER_ALLOW_EXTERNAL_NETWORK=false

# AI Provider Configuration (Strictly Non-Authoritative)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
LLM_ENABLED=false
