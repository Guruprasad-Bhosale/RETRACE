      "id": 3,
      "title": "API Latency (p50 & p95)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(retrace_http_request_duration_seconds_bucket[5m])) by (le))",
